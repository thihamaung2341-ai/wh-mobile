rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace this UID with the store owner's Firebase Authentication UID.
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == "SpebSv19yPPE92rdn75zL4fG8sm2";
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Customers can create bookings only for their own signed-in account.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'customerName', 'phone', 'type', 'item',
          'preferredAt', 'notes', 'status', 'createdAt'
        ])
        && request.resource.data.type in ['reservation', 'repair', 'preorder']
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.currency == 'MMK'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Customer profile documents are private to their owner and store admin.
    match /customers/{userId} {
      allow read, create, update: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}
