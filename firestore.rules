rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace this UID with the store owner's Firebase Authentication UID.
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == "REPLACE_WITH_YOUR_FIREBASE_AUTH_UID";
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      // Customers can create bookings only for their own signed-in account.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'customerName', 'phone', 'type', 'item',
          'preferredAt', 'notes', 'status', 'createdAt'
        ])
        && request.resource.data.type in ['reservation', 'repair']
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Customer profile documents are private to their owner and store admin.
    match /customers/{userId} {
      allow read, create, update: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
  }
}